# =============================================================================
# DEVELOPMENT — full-local stack (Spring profile: dev)
# =============================================================================
# Activated by: `npm run dev`  (mode = development)
#
# Pairs with `application-dev.properties` on the backend. Use this when you're
# running the entire stack on your laptop via ./launch_all.sh — backend on
# :8081, Vite dev server on :5173, no proxy involved (CORS in app-dev.properties
# already allows http://localhost:* origins).
#
# This file is committed. Do not put per-developer overrides here — use
# .env.local (gitignored) for that.
# =============================================================================

VITE_FEDLEARN_API_URL=http://localhost:8081/api
VITE_SERVER_ROOT_URL=http://localhost:8081
