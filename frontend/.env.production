# =============================================================================
# Production environment — bundled into the static assets at `npm run build`.
# =============================================================================
#
# IMPORTANT: both URLs MUST be HTTPS in any deployment where the SPA itself is
# served over HTTPS (Vercel, CloudFront, etc.). The browser blocks mixed-
# content fetches and WebSocket upgrades from HTTPS origins to HTTP backends,
# so an http:// value here silently breaks every API call once deployed.
#
# Replace the host below with your actual TLS-terminated endpoint — e.g.:
#   - an ALB DNS name with an ACM certificate
#   - a CloudFront distribution in front of the API
#   - a custom domain (api.example.com)
#
# Direct EC2 IPs typically don't have certs and will fail; terminate TLS at
# an ALB or behind a domain.
#
# VITE_FEDLEARN_API_URL is what src/api/axiosConfig.ts requires; the build
# fails fast if it's missing. VITE_SERVER_ROOT_URL is consumed by Dashboard
# pages to derive the wss:// origin for the STOMP WebSocket — keep it on the
# same host as the API.

VITE_FEDLEARN_API_URL=https://REPLACE_WITH_YOUR_API_HOST/api
VITE_SERVER_ROOT_URL=https://REPLACE_WITH_YOUR_API_HOST
