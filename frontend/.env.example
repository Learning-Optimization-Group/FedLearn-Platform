# =============================================================================
# FedLearn Frontend — Environment Variables Template
# =============================================================================
# Rename this file to .env.local for local development or .env.production
# for production builds. Vite statically replaces these values during build.

# The Base URL where your FedLearn Spring Boot API is hosted.
# For local dev, this might be http://localhost:8081/api
# For AWS deployment, replace with your Elastic IP, ALB DNS, or Domain (e.g., https://api.my-fedlearn.com/api)
VITE_FEDLEARN_API_URL=http://localhost:8081/api

# The Root URL of your FedLearn backend, used for establishing WebSocket connections (ws:// /topic/logs).
# This is typically the VITE_FEDLEARN_API_URL without the /api suffix.
VITE_SERVER_ROOT_URL=http://localhost:8081
