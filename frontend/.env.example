# =============================================================================
# FedLearn Frontend — Environment Variables Template
# =============================================================================
# This file documents every var the frontend reads. Copy fragments into the
# appropriate mode file:
#
#   .env.development   committed   — paired with Spring `dev` profile
#                                     (full-local: backend on :8081)
#   .env.ec2demo       committed   — paired with Spring `ec2demo` profile
#                                     (Vite proxy → live EC2 backend)
#   .env.production    committed   — paired with Spring `production` profile
#                                     (built bundle for hosted SPA)
#   .env.local         gitignored  — personal overrides (loaded for all modes)
#   .env.[mode].local  gitignored  — personal overrides for one mode
#
# Vite precedence (highest wins):
#   .env.[mode].local > .env.local > .env.[mode] > .env
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED — Spring Boot REST API base URL.
# Production builds fail fast (axiosConfig.ts) if this is missing.
# ---------------------------------------------------------------------------
VITE_FEDLEARN_API_URL=http://localhost:8081/api

# ---------------------------------------------------------------------------
# REQUIRED — Backend root used by Dashboard pages to derive the WebSocket
# origin (ws:// or wss://). Keep on the same host as VITE_FEDLEARN_API_URL.
# ---------------------------------------------------------------------------
VITE_SERVER_ROOT_URL=http://localhost:8081

# ---------------------------------------------------------------------------
# OPTIONAL — Vite dev proxy target. Only consumed by vite.config.ts during
# `npm run dev:*`. When set, /api and /ws-logs paths on localhost:5173 are
# transparently forwarded to this host.
#
# Use this for the ec2demo mode — keeps cookies first-party to localhost
# while talking to a remote backend.
# ---------------------------------------------------------------------------
# VITE_PROXY_TARGET=https://fedlearn.duckdns.org
