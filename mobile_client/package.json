    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "test": "jest",
    "codegen": "react-native codegen"
  },
  "//": "VERSIONS ARE verify-before-use (02-TECH-STACK.md §17): pin exact via `npm view <pkg> version`. RN 0.8x line, NativeWind 4.x, TypeScript 5.x. react-native-reusables components are copied in (shadcn-style), not an npm dependency.",
  "dependencies": {
    "react": "19.1.0",
    "react-native": "0.80.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "react-native-screens": "^4.0.0",
    "react-native-safe-area-context": "^5.0.0",
    "nativewind": "^4.1.0",
    "lucide-react-native": "^0.460.0",
    "axios": "^1.7.0",
    "react-native-encrypted-storage": "^4.0.3",
    "react-native-device-info": "^14.0.0",
    "react-native-svg": "^15.0.0"
  },
  "devDependencies": {
    "@react-native/typescript-config": "0.80.0",
    "@types/react": "^19.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "@react-native/babel-preset": "0.80.0"
  },
  "codegenConfig": {
    "name": "NativeFedLearnCoreSpec",
    "type": "modules",
    "jsSrcsDir": "bridge/specs",
