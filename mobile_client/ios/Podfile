# VERIFY-BEFORE-USE: React Native 0.80 Podfile. New Architecture via RCT_NEW_ARCH_ENABLED=1.
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve("react-native/scripts/react_native_pods.rb", {paths: [process.argv[1]]})',
  __dir__]).strip

platform :ios, '15.1'
prepare_react_native_project!

target 'FedLearn' do
  config = use_native_modules!
  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # The C++ FL core (mobile_client/shared) + gRPC + libtorch are linked into the app target. Add
  # the cross-compiled libtorch/gRPC xcframeworks here (or build shared/ via a vendored xcframework).
  # The bridge C++ (bridge/common/*.cpp, bridge/ios/NativeFedLearnCore.mm, bridge/common/DeviceState.cpp)
  # compiles with the app target. (Wiring is RN-version / Xcode-project specific — verify before use.)
end
