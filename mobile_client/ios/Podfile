# React Native 0.80 Podfile (New Architecture via RCT_NEW_ARCH_ENABLED=1).
# Regenerate the matching Xcode project with: ./generate_xcodeproj.sh
# Resolve react_native_pods.rb with node to allow for hoisting.
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'FedLearn' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # ── FedLearn native FL core (C++ + CXX TurboModule) ────────────────────────────
  # Compiled into the app target by FedLearnCore.podspec (shared/ + bridge/ + gRPC). Enabled when
  # FEDLEARN_NATIVE_IOS is set AND the cross-compiled libtorch/gRPC xcframeworks + buf stubs exist
  # (the podspec raises with exact instructions otherwise). Without it the JS app still builds —
  # AppDelegate falls back via `#if canImport(FedLearnCore)`. Mirrors Android needing LIBTORCH_DIR.
  if ENV['FEDLEARN_NATIVE_IOS']
    pod 'FedLearnCore', :path => './FedLearnCore.podspec'
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )
  end
end
