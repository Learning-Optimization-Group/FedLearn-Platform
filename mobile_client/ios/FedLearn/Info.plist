<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>FedLearn</string>
  <key>CFBundleName</key>
  <string>FedLearn</string>
  <key>CFBundleShortVersionString</key>
  <string>2.0.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>

  <!-- App Transport Security ON: no arbitrary cleartext (matches gRPC TLS+mTLS default, E13). -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <false/>
  </dict>

  <!-- Foreground-only: iOS does not permit arbitrary background compute, so training runs only
       while the app is foregrounded (E5). No background-mode entitlement is requested. -->
  <key>UIBackgroundModes</key>
  <array/>
</dict>
</plist>
