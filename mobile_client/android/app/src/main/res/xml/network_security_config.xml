<?xml version="1.0" encoding="utf-8"?>
<!-- Release HTTP default: TLS-only. The separately linked C++ gRPC transport
     enforces TLS in FedLearnClient; Android's HTTP policy does not guard that channel.
     Local-demo cleartext lives in src/debug/res/xml/network_security_config.xml, which
     overrides this file in debug builds only. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
