<?xml version="1.0" encoding="utf-8"?>
<!-- DEMO BUILD: cleartext permitted so the app can reach an on-LAN FL platform over plain HTTP
     (REST :8081) and plaintext gRPC (:50000-50010). The committed default is TLS-only; this is a
     local demo allowance for talking to a developer's machine on the same network, not for release. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
