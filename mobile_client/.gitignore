# Node / RN
node_modules/
*.log
.expo/

# Native build + cross-compiled dependency artifacts (built by scripts/, never committed)
.build/
.artifacts/
build/

# Exported models + fetched datasets (no committed blobs — A6 §L5 / task 18)
assets/models/*.pt
data/

# Android / iOS build output
android/app/build/
android/.gradle/
ios/Pods/
ios/build/

# Commit the Gradle wrapper jar (root .gitignore's `*.jar` would otherwise drop it; it bootstraps
# ./gradlew on a fresh clone, ~49KB).
!android/gradle/wrapper/gradle-wrapper.jar

# Local-only Xcode env override produced by `pod install` (the versioned .xcode.env IS committed).
ios/.xcode.env.local
# CocoaPods workspace is regenerated by `pod install`.
ios/FedLearn.xcworkspace/
scratch/
