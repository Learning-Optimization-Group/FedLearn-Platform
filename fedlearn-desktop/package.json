{
  "name": "fedlearn-desktop",
  "version": "3.2.0-beta",
  "description": "FedLearn Desktop Client — Docker-based Federated Learning Orchestrator",
  "main": "dist/main/main.js",
  "author": {
    "name": "FedLearn Team",
    "email": "[EMAIL_ADDRESS]"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anurag2796/FedLearn-Platform.git"
  },
  "scripts": {
    "dev:renderer": "webpack serve --config webpack.renderer.config.js --mode development",
    "dev:main": "webpack --config webpack.main.config.js --mode development --watch",
    "dev:preload": "webpack --config webpack.preload.config.js --mode development --watch",
    "dev:electron": "electron dist/main/main.js",
    "dev": "concurrently --kill-others \"npm run dev:preload\" \"npm run dev:main\" \"npm run dev:renderer\" \"sleep 3 && npm run dev:electron\"",
    "build:main": "webpack --config webpack.main.config.js --mode production",
    "build:preload": "webpack --config webpack.preload.config.js --mode production",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "build": "webpack --config webpack.prod.config.js",
    "test": "jest",
    "package": "npm run build && electron-builder --config electron-builder.yml",
    "package:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "package:linux": "npm run build && electron-builder --linux --config electron-builder.yml",
    "package:win:cpu": "npm run build && electron-builder --win --config electron-builder.yml -c.nsis.artifactName=FedLearn-Desktop-Setup-${version}-cpu.exe",
    "package:win:cuda": "npm run build && electron-builder --win --config electron-builder.yml -c.nsis.artifactName=FedLearn-Desktop-Setup-${version}-cuda.exe"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "dockerode": "^4.0.10",
    "electron-log": "5.3.0",
    "electron-store": "8.2.0",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "protobufjs": ">=7.5.5"
  },
  "devDependencies": {
    "@types/dockerode": "3.3.34",
    "@types/jest": "^29.5.14",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "concurrently": "9.1.2",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "7.1.2",
    "electron": "^42.4.0",
    "electron-builder": "^26.8.1",
    "html-webpack-plugin": "5.6.3",
    "style-loader": "4.0.0",
    "terser-webpack-plugin": "^5.4.0",
    "ts-jest": "^29.3.2",
    "ts-loader": "9.5.1",
    "typescript": "5.7.3",
    "webpack": "^5.106.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "^5.2.3"
  }
}
