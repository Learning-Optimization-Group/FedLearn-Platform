# =============================================================================
# FedLearn-Platform — Root .gitignore
# =============================================================================

# ========================
# Environments & Secrets
# ========================
.env
.env.local
.env.*.local
env.txt
backend/fl-platform-api/env.txt
# curl/test cookie jars — must never be committed (may carry live JWT cookies)
cookies.txt
**/cookies.txt

# ========================
# Python
# ========================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/

# ========================
# Java / Spring Boot / Gradle
# ========================
target/
build/
!fedlearn-desktop/build/
!gradle/wrapper/gradle-wrapper.jar
.gradle/
*.jar
*.war
*.ear
*.class
.mvn/wrapper/maven-wrapper.jar
bin/

# ========================
# Node / React
# ========================
node_modules/
dist/
.vite/
release/

# ========================
# ML Artifacts & Data
# ========================
*.pth
*.pkl
*.npz
checkpoints/
results/
models/

# Source package dirs that collide with the ML-artifact "models/" rule above
!backend/fl-platform-api/src/main/resources/scripts/models/
!backend/fl-platform-api/src/main/resources/scripts/models/**
!client-docker/scripts/models/
!client-docker/scripts/models/**

# ========================
# Logs & Ephemeral Data
# ========================
logs/
*.log
backend/Logs.txt
**/*.csv
data/

# ========================
# IDE / Editor
# ========================
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~
.DS_Store
._*
.aider*
.clinerules
CLAUDE.md
.claude/
**/.claude/

# ========================
# Native / Compiled
# ========================
*.so
*.dylib
*.dll

MULTI_DEVICE_TESTING_GUIDE.md

# Documentation folder — only wikis/ (top-level) is committed
/docs

# Cline CLI config (dir form; .clinerules covered above)
.cline/

# ========================
# Additional Standard Ignores
# ========================
# Node
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache
*.tsbuildinfo
.next/
out/

# Python
.tox/
.coverage
htmlcov/
wheels/
*.egg

# OS
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Security
*.pem
*.key
*.cert
*.crt
id_rsa*

# Local scratch / crash-recovery workspace (never commit)
.temp/

# Playwright MCP browser session artifacts (local tooling output)
.playwright-mcp/

# React Native iOS — reproducible build output from ios/generate_xcodeproj.sh
# (the script commits only its declarative inputs: the script, ios/FedLearn/*, ios/Podfile)
mobile_client/ios/FedLearn.xcodeproj/
mobile_client/ios/FedLearn.xcworkspace/
mobile_client/ios/Pods/
mobile_client/ios/.xcode.env.local
