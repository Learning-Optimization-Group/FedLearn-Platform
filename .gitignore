# =============================================================================
# FedLearn-Platform — Root .gitignore
# =============================================================================

# ========================
# Environments & Secrets
# ========================
.env
.env.local
.env.*.local
env.txt
backend/fl-platform-api/env.txt

# ========================
# Python
# ========================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
venv/
.venv/
env/

# ========================
# Java / Spring Boot / Gradle
# ========================
target/
build/
!gradle/wrapper/gradle-wrapper.jar
.gradle/
*.jar
*.war
*.ear
*.class
.mvn/wrapper/maven-wrapper.jar
bin/

# ========================
# Node / React
# ========================
node_modules/
dist/
.vite/
release/

# ========================
# ML Artifacts & Data
# ========================
*.pth
*.pkl
*.npz
checkpoints/
results/
models/

# ========================
# Logs & Ephemeral Data
# ========================
logs/
*.log
backend/Logs.txt
**/*.csv
data/

# ========================
# IDE / Editor
# ========================
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~
.DS_Store
CLAUDE.md

# ========================
# Native / Compiled
# ========================
*.so
*.dylib
*.dll

