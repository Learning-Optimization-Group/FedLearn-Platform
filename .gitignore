# =============================================================================
# FedLearn-Platform — Root .gitignore
# =============================================================================

# ========================
# Environments & Secrets
# ========================
.env
.env.local
.env.*.local
env.txt
backend/fl-platform-api/env.txt
# curl/test cookie jars — must never be committed (may carry live JWT cookies)
cookies.txt
**/cookies.txt

# ========================
# Python
# ========================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
venv/
.venv/
env/

# ========================
# Java / Spring Boot / Gradle
# ========================
target/
build/
!fedlearn-desktop/build/
!gradle/wrapper/gradle-wrapper.jar
.gradle/
*.jar
*.war
*.ear
*.class
.mvn/wrapper/maven-wrapper.jar
bin/

# ========================
# Node / React
# ========================
node_modules/
dist/
.vite/
release/

# ========================
# ML Artifacts & Data
# ========================
*.pth
*.pkl
*.npz
checkpoints/
results/
models/

# Source package dirs that collide with the ML-artifact "models/" rule above
!backend/fl-platform-api/src/main/resources/scripts/models/
!backend/fl-platform-api/src/main/resources/scripts/models/**
!client-docker/scripts/models/
!client-docker/scripts/models/**

# ========================
# Logs & Ephemeral Data
# ========================
logs/
*.log
backend/Logs.txt
**/*.csv
data/

# ========================
# IDE / Editor
# ========================
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~
.DS_Store
CLAUDE.md
.claude/
**/.claude/

# ========================
# Native / Compiled
# ========================
*.so
*.dylib
*.dll

docs/llm_dumps/
docs/testing/
docs/guides/aws_deployment_guide.md
docs/ULTRAREVIEW_AUDIT.md
MULTI_DEVICE_TESTING_GUIDE.md
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v4/
docs/superpowers/plans/2026-05-12-rbac-backend-foundation.md
docs/superpowers/specs/2026-05-12-rbac-and-model-hub-design.md
