# =============================================================================
# FedLearn-Platform — Root .gitignore
# =============================================================================

# ========================
# Environments & Secrets
# ========================
.env
.env.local
.env.*.local
env.txt
backend/fl-platform-api/env.txt
# curl/test cookie jars — must never be committed (may carry live JWT cookies)
cookies.txt
**/cookies.txt

# ========================
# Python
# ========================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/

# ========================
# Java / Spring Boot / Gradle
# ========================
target/
build/
!fedlearn-desktop/build/
!gradle/wrapper/gradle-wrapper.jar
.gradle/
*.jar
*.war
*.ear
*.class
.mvn/wrapper/maven-wrapper.jar
bin/

# ========================
# Node / React
# ========================
node_modules/
dist/
.vite/
release/

# ========================
# ML Artifacts & Data
# ========================
*.pth
*.pkl
*.npz
checkpoints/
results/
models/
# FL-server registered model artifacts (FULL_CHECKPOINT / LORA_ADAPTER) written at runtime
backend/fl-platform-api/artifact-store/

# Source package dirs that collide with the ML-artifact "models/" rule above
!fl-runtime/models/
!fl-runtime/models/**
# ...but the "**" re-inclusion above also re-tracks Python bytecode caches inside that
# source dir (it overrides the global __pycache__/ rule). Re-ignore just the caches.
fl-runtime/models/**/__pycache__/

# ========================
# Logs & Ephemeral Data
# ========================
logs/
*.log
backend/Logs.txt
**/*.csv
data/

# ========================
# IDE / Editor
# ========================
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~
.DS_Store
._*
.aider*
.clinerules
CLAUDE.md
.claude/
**/.claude/

# ========================
# Native / Compiled
# ========================
*.so
*.dylib
*.dll

MULTI_DEVICE_TESTING_GUIDE.md

# Documentation folder — only wikis/ (top-level) is committed
/docs

# Cline CLI config (dir form; .clinerules covered above)
.cline/

# ========================
# Additional Standard Ignores
# ========================
# Node
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache
*.tsbuildinfo
.next/
out/

# Python
.tox/
.coverage
htmlcov/
wheels/
*.egg

# JS/JVM coverage report output (vitest/jest v8 + jacoco html) — generated, never committed (TE-11)
coverage/

# OS
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Security
*.pem
*.key
*.cert
*.crt
id_rsa*

# Local scratch / crash-recovery workspace (never commit)
.temp/

# Playwright MCP browser session artifacts (local tooling output)
.playwright-mcp/

# research/ is the paper's local-only working area (results, notes, experiment logs) — not tracked.
research/

# --- Build outputs and machine-local config (added 2026-07-29) ---
# Android NDK/CMake externalNativeBuild scratch — ~180 MB of regenerable object files.
mobile_client/android/app/.cxx/
# Local host/device CMake build trees for the native core.
mobile_client/build-host/
mobile_client/build-train/
# Machine-local SDK/NDK paths. Never portable, and Gradle regenerates it.
mobile_client/android/local.properties

# Generated protobuf/gRPC stubs. The contract lives in proto/*.proto; `buf generate`
# reproduces these, and committing them invites the mirror drift proto.yml exists to prevent.
proto/gen/

# Stray local artifacts
report-top.jpeg
*.log.*.marker
