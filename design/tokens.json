{
  "$description": "FedLearn 'Ember' design tokens — the single source of truth for web, desktop, and mobile. Concept: warm 'ember' device-lights on a pure AMOLED-black field (privacy = the void, collaboration = the glow). Edit ONLY this file, then run `node design/build-tokens.mjs` to regenerate the per-platform artifacts. See docs/design/ember-design-system.md.",
  "color": {
    "light": {
      "canvas": "#FBF9F6",
      "surface-1": "#FFFFFF",
      "surface-2": "#F4F1EC",
      "surface-3": "#ECE7DF",
      "code-well": "#F6F3EE",
      "hairline": "#E7E1D8",
      "line": "#D8D1C5",
      "fg": "#1A1714",
      "fg-muted": "#6B6358",
      "fg-subtle": "#938A7D",
      "accent": "#C56A1E",
      "accent-hover": "#A9591A",
      "accent-fg": "#FFFFFF",
      "success": "#1F9D57",
      "warning": "#B07D0A",
      "danger": "#CE3F38",
      "running": "#C56A1E"
    },
    "dark": {
      "canvas": "#000000",
      "surface-1": "#0B0A09",
      "surface-2": "#141210",
      "surface-3": "#1E1B17",
      "code-well": "#050504",
      "hairline": "rgba(255, 244, 232, 0.08)",
      "line": "rgba(255, 244, 232, 0.15)",
      "fg": "#F5F1EA",
      "fg-muted": "#A8A096",
      "fg-subtle": "#6E665C",
      "accent": "#F7A35C",
      "accent-hover": "#FFB877",
      "accent-fg": "#1C0F03",
      "success": "#5FD39B",
      "warning": "#EBC152",
      "danger": "#FF6B5E",
      "running": "#F7A35C"
    },
    "series": ["#F7A35C", "#5FD39B", "#6FA8FF", "#C79BFF", "#EBC152", "#FF8CA6", "#4FD6C9", "#A8A096"]
  },
  "radius": { "sm": "6px", "md": "9px", "lg": "12px", "card": "16px", "pill": "9999px" },
  "space": { "0.5": "2px", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px", "16": "64px" },
  "duration": { "fast": "120ms", "base": "180ms", "slow": "280ms" },
  "ease": { "out": "cubic-bezier(0.16, 1, 0.3, 1)", "in-out": "cubic-bezier(0.4, 0, 0.2, 1)" },
  "font": {
    "sans": "'Hanken Grotesk', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "display": "'Bricolage Grotesque', 'Hanken Grotesk', ui-sans-serif, system-ui, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace",
    "feature-settings": "'calt' 1, 'tnum' 1"
  },
  "text": {
    "caption": { "size": "12px", "line": "16px", "tracking": "0.1px", "weight": "500" },
    "label":   { "size": "13px", "line": "18px", "tracking": "0px", "weight": "500" },
    "body":    { "size": "14px", "line": "20px", "tracking": "0px", "weight": "400" },
    "body-lg": { "size": "16px", "line": "24px", "tracking": "-0.05px", "weight": "400" },
    "h4":      { "size": "18px", "line": "24px", "tracking": "-0.2px", "weight": "600" },
    "h3":      { "size": "22px", "line": "28px", "tracking": "-0.4px", "weight": "600" },
    "h2":      { "size": "30px", "line": "36px", "tracking": "-0.8px", "weight": "600" },
    "h1":      { "size": "40px", "line": "44px", "tracking": "-1.4px", "weight": "700" }
  }
}
