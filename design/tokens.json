{
  "$description": "FedLearn 'Instrument' design tokens — the single source of truth for web, desktop, and mobile. Edit ONLY this file, then run `node design/build-tokens.mjs` to regenerate the per-platform artifacts. See docs/design/instrument-design-system.md.",
  "color": {
    "light": {
      "canvas": "#FCFCFD",
      "surface-1": "#FFFFFF",
      "surface-2": "#F6F7F9",
      "surface-3": "#F0F2F5",
      "code-well": "#F4F6F8",
      "hairline": "#E6E8EC",
      "line": "#D5D8DE",
      "fg": "#16181D",
      "fg-muted": "#5B6470",
      "fg-subtle": "#8A93A0",
      "accent": "#0E8FB8",
      "accent-hover": "#0B7D9F",
      "accent-fg": "#FFFFFF",
      "success": "#1F9D57",
      "warning": "#B8860B",
      "danger": "#D23F3F",
      "running": "#0E8FB8"
    },
    "dark": {
      "canvas": "#0A0C10",
      "surface-1": "#0F1216",
      "surface-2": "#14181D",
      "surface-3": "#191E24",
      "code-well": "#06080B",
      "hairline": "rgba(255, 255, 255, 0.07)",
      "line": "rgba(255, 255, 255, 0.13)",
      "fg": "#ECEEF2",
      "fg-muted": "#8A93A0",
      "fg-subtle": "#5B6470",
      "accent": "#22B8D6",
      "accent-hover": "#3FC6E0",
      "accent-fg": "#06121A",
      "success": "#34D399",
      "warning": "#FBBF24",
      "danger": "#F87171",
      "running": "#22B8D6"
    },
    "series": ["#0072B2", "#D55E00", "#009E73", "#E69F00", "#56B4E9", "#CC79A7", "#F0E442", "#8A93A0"]
  },
  "radius": { "sm": "4px", "md": "6px", "lg": "8px", "card": "12px", "pill": "9999px" },
  "space": { "0.5": "2px", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px", "16": "64px" },
  "duration": { "fast": "120ms", "base": "160ms", "slow": "240ms" },
  "ease": { "out": "cubic-bezier(0.16, 1, 0.3, 1)", "in-out": "cubic-bezier(0.4, 0, 0.2, 1)" },
  "font": {
    "sans": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace",
    "feature-settings": "'cv05' 1, 'ss03' 1, 'calt' 1, 'tnum' 1"
  },
  "text": {
    "caption": { "size": "12px", "line": "16px", "tracking": "0.1px", "weight": "500" },
    "label":   { "size": "13px", "line": "18px", "tracking": "0px", "weight": "500" },
    "body":    { "size": "14px", "line": "20px", "tracking": "0px", "weight": "400" },
    "body-lg": { "size": "16px", "line": "24px", "tracking": "-0.05px", "weight": "400" },
    "h4":      { "size": "18px", "line": "24px", "tracking": "-0.2px", "weight": "600" },
    "h3":      { "size": "22px", "line": "28px", "tracking": "-0.4px", "weight": "600" },
    "h2":      { "size": "28px", "line": "34px", "tracking": "-0.7px", "weight": "600" },
    "h1":      { "size": "36px", "line": "42px", "tracking": "-1.2px", "weight": "600" }
  }
}
