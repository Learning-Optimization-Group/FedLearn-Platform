# =============================================================================
# FedLearn Platform API — Environment Variables Template
# =============================================================================
# Copy this file to .env and populate with real values.
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# =============================================================================

# --- AWS / Infrastructure ---
AWS_HOST="127.0.0.1"

# --- PostgreSQL Datasource ---
SPRING_DATASOURCE_URL="jdbc:postgresql://localhost:5432/federated_platform_db"
SPRING_DATASOURCE_USERNAME="postgres"
SPRING_DATASOURCE_PASSWORD="change_me"

# --- JWT Authentication ---
# Generate a secure random 512-bit key:
#   openssl rand -hex 64
APP_JWT_SECRET="generate_a_secure_random_base64_string_here"
APP_JWT_EXPIRATION_MS="3600000"

# --- Python Script Paths (relative to Spring Boot working dir) ---
PYTHON_EXECUTABLE_PATH="src/main/resources/scripts/run_init_model.sh"
PYTHON_FLBAT_PATH="src/main/resources/scripts/run_fl_server.sh"
PYTHON_SCRIPT_INIT_MODEL_PATH="src/main/resources/scripts/init_model.py"
PYTHON_SCRIPT_FL_SERVER_PATH="src/main/resources/scripts/run_fl_server.sh"
