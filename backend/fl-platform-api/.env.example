# =============================================================================
# FedLearn Platform API — Environment Variables Template
# =============================================================================
# Copy this file to .env and populate with real values.
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# =============================================================================

# --- PostgreSQL Datasource ---
SPRING_DATASOURCE_URL="jdbc:postgresql://localhost:5432/federated_platform_db"
SPRING_DATASOURCE_USERNAME="postgres"
SPRING_DATASOURCE_PASSWORD="change_me"

# --- JWT Authentication ---
# Generate a secure random 512-bit key:
#   openssl rand -hex 64
APP_JWT_SECRET="generate_a_secure_random_base64_string_here"
APP_JWT_EXPIRATION_MS="3600000"

# --- Internal service-to-service API key ---
# Shared by the backend and the FL-server tasks it launches. The FL server
# must send this in the X-Internal-Key header for every /api/internal/** call.
# Generate:
#   openssl rand -hex 32
APP_INTERNAL_API_KEY="generate_a_secure_random_hex_string_here"

# URL the FL-server Fargate task uses to call back into this backend.
# Use an internal (VPC-reachable) ALB DNS or Cloud Map service name in prod.
# Leave empty for local dev — the FL-server falls back to SERVER_HOST:8081.
APP_BACKEND_INTERNAL_URL=""

# --- CORS ---
# Comma-separated origins allowed to talk to this API from a browser.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# --- ECS / Fargate ---
# The ECS/Fargate managed-task path is NOT implemented; FlowerServerManager fails closed if this
# is set. Leave blank to run FL servers as local processes. (Other ECS_* vars were removed with
# the dead code.)
ECS_CLUSTER_NAME=""

# --- Python script paths (only used by legacy local-process fallback) ---
PYTHON_EXECUTABLE_PATH="../../fl-runtime/run_init_model.sh"
PYTHON_FLBAT_PATH="../../fl-runtime/run_fl_server.sh"
PYTHON_SCRIPT_INIT_MODEL_PATH="../../fl-runtime/init_model.py"
PYTHON_SCRIPT_FL_SERVER_PATH="../../fl-runtime/run_fl_server.sh"
