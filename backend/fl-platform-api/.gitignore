# ==================================
# Build artifacts
# ==================================
build/
.gradle/
# IntelliJ's default Java output path when the project hasn't been re-imported
# as a Gradle module; keep ignored so stale IDE output never gets committed.
target/
*.jar
# The Gradle wrapper jar MUST be committed so `./gradlew` can bootstrap (it carries
# org.gradle.wrapper.GradleWrapperMain). Re-include it despite the *.jar rule above.
!gradle/wrapper/gradle-wrapper.jar
*.war
*.ear

# ==================================
# IDE files
# ==================================
.idea/
.vscode/
*.iml
*.iws
*.ipr
.classpath
.project
.settings
.factorypath

# ==================================
# Python
# ==================================
# Virtual environments
venv/
.venv/
env/
.env/
# Python cache
__pycache__/
*.py[cod]
*$py.class
# Datasets
data/
../../models/

# ==================================
# Log files and temp files
# ==================================
*.log
*.tmp
nohup.out

# ==================================
# OS-specific
# ==================================
.DS_Store
Thumbs.db